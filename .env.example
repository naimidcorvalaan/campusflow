TJU_LLM_API_KEY=your_api_key_here
TJU_LLM_BASE_URL=https://ai.tju.edu.cn/api/v3
TJU_LLM_MODEL=tju-llm
# 服务器建议设置为源码目录外的持久卷；本地可留空使用平台默认目录。
CAMPUSFLOW_DATA_DIR=

# 默认仍是 TJU；仅显式设为 deepseek 时使用另一服务。
CAMPUSFLOW_LLM_PROVIDER=tju
# 可选 DeepSeek 配置（不要在仓库提交真实 key）。
# DEEPSEEK_API_KEY=<your-deepseek-key>
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_VISION_MODEL=deepseek-flash
