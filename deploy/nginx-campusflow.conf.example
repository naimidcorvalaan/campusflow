# Replace the reserved example hostname and certificate paths.
# This example assumes a separately configured, mature auth gateway such as
# oauth2-proxy on 127.0.0.1:4180. On Streamlit 1.31.1 this remains an
# access-control example only: CampusFlow intentionally does not read private
# Streamlit WebSocket-header APIs as a production identity source.
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

upstream campusflow_streamlit {
    server 127.0.0.1:8501;
}

server {
    listen 443 ssl http2;
    server_name campusflow.test.example;

    ssl_certificate /etc/ssl/campusflow/fullchain.pem;
    ssl_certificate_key /etc/ssl/campusflow/privkey.pem;

    location = /oauth2/auth {
        proxy_pass http://127.0.0.1:4180;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
    }

    location /oauth2/ {
        proxy_pass http://127.0.0.1:4180;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        auth_request /oauth2/auth;
        error_page 401 = /oauth2/sign_in;

        # The browser must never be able to choose the identity header. The
        # value below comes only from oauth2-proxy's auth subrequest. Configure
        # the gateway's user-id claim to the provider's stable OIDC `sub`
        # before a future public-header adapter consumes it.
        auth_request_set $campusflow_auth_subject $upstream_http_x_auth_request_user;

        proxy_pass http://campusflow_streamlit;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-CampusFlow-Auth-Provider "gateway-oidc";
        proxy_set_header X-CampusFlow-Auth-Subject $campusflow_auth_subject;
        # Provider tokens are neither needed nor persisted by CampusFlow.
        proxy_set_header Authorization "";
        proxy_set_header X-Forwarded-Access-Token "";
        proxy_set_header X-Auth-Request-Access-Token "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 86400;
        proxy_buffering off;
    }
}
