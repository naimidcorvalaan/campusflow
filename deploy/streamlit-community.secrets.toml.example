# Copy these TOP-LEVEL entries into Community Cloud > Advanced settings > Secrets.
# Replace only the three placeholders with your current service configuration.
# Do not commit a real secrets.toml. No [tju] section: root entries become env vars.
TJU_LLM_BASE_URL = "https://your-service.invalid/v1"
TJU_LLM_MODEL = "your-model-id"
TJU_LLM_API_KEY = "replace-with-your-service-key"

# Cloud only. Apply the Tianjin clock after Streamlit loads these secrets.
TZ = "Asia/Shanghai"

# Writable DEMO storage, not a durable volume; loss must be acceptable.
# This setting does not affect the user's local Windows profile directory.
CAMPUSFLOW_DATA_DIR = "/tmp/campusflow"
