# TOP-LEVEL Streamlit Secrets; values become server process environment variables.
# Restricted demonstration only. Never commit real secrets.toml or service keys.
CAMPUSFLOW_LLM_PROVIDER = "deepseek"
DEEPSEEK_API_KEY = "<set in Streamlit Cloud only>"
DEEPSEEK_BASE_URL = "https://api.deepseek.com"
# Current official Flash supports text and images; keep separate selection slots.
DEEPSEEK_MODEL = "deepseek-flash"
DEEPSEEK_VISION_MODEL = "deepseek-flash"

TZ = "Asia/Shanghai"
# Disposable DEMO storage, not durable across restarts/redeployments.
CAMPUSFLOW_DATA_DIR = "/tmp/campusflow"
