# Prototype-only shape for a future Streamlit 1.45+ deployment.
# Copy outside Git as .streamlit/secrets.toml and replace every placeholder.
# Never commit the populated file.
[auth]
redirect_uri = "https://campusflow.test.example/oauth2callback"
cookie_secret = "replace_with_a_long_random_secret"

[auth.campusflow-oidc]
client_id = "replace_with_provider_client_id"
client_secret = "replace_with_provider_client_secret"
server_metadata_url = "https://identity.example/.well-known/openid-configuration"
